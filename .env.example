# Core AI feature
GROQ_API_KEY=

# Supabase (required for accounts/auth + user data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional modern key name supported by this app (use this or ANON key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contact form email delivery (required for /api/contact)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App base URL (used for origin checks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bot protection (recommended in production)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional distributed rate-limiting provider (future hardening)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional encryption key for security helpers
ENCRYPTION_KEY=
